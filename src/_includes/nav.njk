<h2 class="nav-heading">Navigation</h2>

<table class="nav-table" role="presentation">
  {% for item in navigation %}
  <tr>
    <td>
		<a class="nav-link {% if page.url == item.url %}active{% endif %}" href="{{ item.url | url }}">
		{{ item.name }}
		</a>
    </td>
  </tr>
  {% endfor %}
</table>

<div class="content-box" style="margin-top: 12px;">
  <h3>System Status</h3>
  <p>Relay: ONLINE</p>
  <p>Surface Comms: DEGRADED</p>
  <p class="blink">Sublevel Signal: PRESENT</p>
</div>